# Allowlist for the loopback-only default (ALLOW_LIVE_SITES off/unset).
# Exact origins, comma-separated; each must equal its own URL origin (no path/query)
# and name a loopback host (localhost, 127.0.0.1, [::1]). Defaults to http://127.0.0.1:3001.
# NOT required when ALLOW_LIVE_SITES=true — in live mode the per-run allowed origin
# is derived from the ORIGIN of the URL you submit (any public site, no pre-listing).
ALLOWED_ORIGINS=http://127.0.0.1:3001

# Reasoning backend: "mock" (default, offline fixture flow) or "meta" (live Meta Model API).
MODEL_MODE=mock
# Expose to the UI so the badge and labels update. Must match MODEL_MODE above.
NEXT_PUBLIC_MODEL_MODE=mock

# Allow analyzing any public http(s) site. Default (unset/false) is loopback-only.
# When true, the allowed origin is taken from the submitted URL (ALLOWED_ORIGINS
# not required), and private/internal/loopback targets are rejected (SSRF guard).
# GQ-011 review accepts one public URL and blocks non-GET/HEAD requests.
ALLOW_LIVE_SITES=false
# Expose to the UI so labels and hints update. Must match ALLOW_LIVE_SITES above.
NEXT_PUBLIC_ALLOW_LIVE_SITES=false

# Meta Model API (Muse) — OpenAI-compatible, base URL https://api.meta.ai/v1.
# Required when MODEL_MODE=meta. Never commit a real key.
MODEL_API_KEY=
# Model ID, defaults to muse-spark-1.3 when unset.
MODEL_ID=muse-spark-1.3
# Optional base URL override; defaults to https://api.meta.ai/v1.
MODEL_BASE_URL=https://api.meta.ai/v1

MAX_AGENT_ACTIONS=10
RUN_TIMEOUT_MS=60000
